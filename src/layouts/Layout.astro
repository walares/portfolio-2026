---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import { site } from "../data/site";
import { getLocaleContent, type Locale } from "../i18n";
import type { SeoProps } from "../lib/seo";

interface Props extends SeoProps {
	locale: Locale;
}

const { locale, title, description, path, noindex = false, ogImagePath } = Astro.props;
const content = getLocaleContent(locale);
---

<!doctype html>
<html lang={content.language}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="512x512" href={site.logoPath} />
		<link rel="apple-touch-icon" href={site.logoPath} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description ?? content.description} />
		<title>{title ?? content.title}</title>
		<SeoHead
			{locale}
			title={title ?? content.title}
			description={description ?? content.description}
			path={path ?? content.path}
			{noindex}
			ogImagePath={ogImagePath}
		/>
	</head>
	<body
		class="min-h-dvh antialiased accent-brand-green selection:bg-brand-green/28 selection:text-white underline-offset-[0.22em]"
	>
		<a href="#contenido-principal" class="skip-link">{content.skipLink}</a>
		<slot />
		<script>
			import "../scripts/smooth-scroll.ts";
			import "../scripts/scroll-reveal.ts";
			import "../scripts/site-effects.ts";
			import "../scripts/hero-spacetime-grid.ts";
		</script>
	</body>
</html>
