---
import { site } from "../data/site";
import { defaultLocale, getAlternateLocale, getLocaleContent, type Locale } from "../i18n";
import { buildJsonLd, getHreflangAlternates, resolveSeo, type SeoProps } from "../lib/seo";

type Props = SeoProps;

const props = Astro.props;
const locale = props.locale ?? defaultLocale;
const content = getLocaleContent(locale);
const seo = resolveSeo(props);
const jsonLd = buildJsonLd(locale, props.path ?? content.path);
const alternates = getHreflangAlternates(content.path);
const alternateLocale = getAlternateLocale(locale);
const alternateContent = getLocaleContent(alternateLocale);
const countryName = locale === "en" ? site.location.countryEn : site.location.country;
---

<!-- Canonical y indexación -->
<link rel="canonical" href={seo.canonical} />
{seo.noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<!-- Identidad -->
<meta name="author" content={site.personName} />
<meta name="keywords" content={content.keywords.join(", ")} />
<meta name="theme-color" content="#0a0f0d" />
<meta name="color-scheme" content="dark" />
<meta http-equiv="content-language" content={content.hreflang} />
<meta name="geo.region" content={site.location.geoRegion} />
<meta name="geo.placename" content={`${site.location.city}, ${countryName}`} />
<meta name="geo.position" content={`${site.location.latitude};${site.location.longitude}`} />
<meta name="ICBM" content={`${site.location.latitude}, ${site.location.longitude}`} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={content.hreflang.replace("-", "_")} />
<meta property="og:locale:alternate" content={alternateContent.hreflang.replace("-", "_")} />
<link rel="alternate" hreflang="es-PE" href={alternates.es} />
<link rel="alternate" hreflang="en-US" href={alternates.en} />
<link rel="alternate" hreflang="x-default" href={alternates.default} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:image:width" content={String(site.ogImageWidth)} />
<meta property="og:image:height" content={String(site.ogImageHeight)} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={content.seo.ogImageAlt} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />
<meta name="twitter:image:alt" content={`${site.personName} — ${site.name}`} />
{site.twitterHandle ? <meta name="twitter:site" content={`@${site.twitterHandle}`} /> : null}
{site.twitterHandle ? <meta name="twitter:creator" content={`@${site.twitterHandle}`} /> : null}

<!-- Descubrimiento por crawlers de IA (llms.txt) -->
<link rel="alternate" type="text/plain" href="/llms.txt" hreflang="es-PE" title={getLocaleContent("es").seo.llmsTitle} />
<link rel="alternate" type="text/plain" href="/llms-full.txt" hreflang="es-PE" title={getLocaleContent("es").seo.llmsFullTitle} />
<link rel="alternate" type="text/plain" href="/en/llms.txt" hreflang="en-US" title={getLocaleContent("en").seo.llmsTitle} />
<link rel="alternate" type="text/plain" href="/en/llms-full.txt" hreflang="en-US" title={getLocaleContent("en").seo.llmsFullTitle} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
