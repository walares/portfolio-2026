---
import { site } from "../data/site";
import { buildJsonLd, resolveSeo, type SeoProps } from "../lib/seo";

type Props = SeoProps;

const props = Astro.props;
const seo = resolveSeo(props);
const jsonLd = buildJsonLd(props.path ?? "/");
---

<!-- Canonical y indexación -->
<link rel="canonical" href={seo.canonical} />
{seo.noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<!-- Identidad -->
<meta name="author" content={site.personName} />
<meta name="keywords" content={site.keywords.join(", ")} />
<meta name="theme-color" content="#0a0f0d" />
<meta name="color-scheme" content="dark" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale.replace("_", "-")} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:image:alt" content={`${site.personName} — ${site.name}: diseño y desarrollo web`} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />
<meta name="twitter:image:alt" content={`${site.personName} — ${site.name}`} />

<!-- Descubrimiento por crawlers de IA (llms.txt) -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen del sitio para LLMs" />
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="Resumen extendido para LLMs" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
