---
import { ArrowUpRight, FolderOpen } from "@lucide/astro";
import { portfolioProjects as projects } from "../data/portfolio";
import { siteScreenshotUrl } from "../lib/siteScreenshot";
---

<section
	id="work"
	class="relative scroll-mt-24 overflow-hidden px-4 py-20 sm:px-6 sm:py-28 lg:px-8"
	aria-labelledby="work-heading"
>
	<div
		class="graphic-orb graphic-orb--green left-0 top-1/4 size-[min(22rem,55vw)] -translate-y-1/2 opacity-25"
		data-parallax="0.05"
		aria-hidden="true"
	/>
	<div class="mx-auto max-w-6xl">
		<header class="featured-work__header reveal">
			<div class="featured-work__header-row">
				<div>
					<p class="eyebrow-pill mb-5">
						<FolderOpen size={14} stroke-width={2} class="text-brand-green" aria-hidden="true" />
						Portfolio
					</p>
					<h2
						id="work-heading"
						class="headline-section text-pretty text-3xl text-white sm:text-4xl lg:text-[2.85rem]"
					>
						Proyectos
						<span class="headline-muted"> destacados</span>
					</h2>
				</div>
				<p class="featured-work__count text-eyebrow-brand">
					{String(projects.length).padStart(2, "0")} sitios · 2022 — 2026
				</p>
			</div>
			<p class="text-muted-body mt-5 max-w-2xl text-base sm:text-lg">
				Selección de webs en producción. Haz clic en cualquier proyecto para verlo en vivo.
			</p>
		</header>

		<ul class="featured-work__grid reveal-stagger mt-12 lg:mt-14" aria-label="Proyectos publicados">
			{
				projects.map((p) => (
					<li>
						<a
							href={p.url}
							target="_blank"
							rel="noopener noreferrer"
							class="featured-work__card group"
						>
							<div class="featured-work__media">
								<div
									class:list={[
										"featured-work__glow pointer-events-none absolute inset-0 bg-gradient-to-br opacity-0 transition-opacity duration-500 group-hover:opacity-100",
										p.accent.glow,
									]}
									aria-hidden="true"
								/>
								{p.scrollGif ? (
									<img
										src={p.scrollGif}
										alt=""
										class="featured-work__img h-full w-full object-cover object-top"
										loading="lazy"
										decoding="async"
									/>
								) : p.previewLocal ? (
									<img
										src={p.previewLocal}
										alt=""
										class="featured-work__img portfolio-preview-pan max-h-none w-full"
										loading="lazy"
										decoding="async"
										width="1200"
										height="750"
									/>
								) : (
									<img
										src={siteScreenshotUrl(p.url)}
										alt=""
										class="featured-work__img portfolio-preview-pan max-h-none w-full"
										loading="lazy"
										decoding="async"
										width="1200"
										height="750"
									/>
								)}
								<span class="featured-work__visit" aria-hidden="true">
									<ArrowUpRight size={18} stroke-width={2} />
								</span>
							</div>
							<div class="featured-work__body">
								<h3 class="featured-work__title font-display">{p.title}</h3>
								<div class="featured-work__meta">
									<span
										class:list={[
											"rounded-full px-2.5 py-0.5 text-[11px] font-semibold",
											p.accent.pill,
										]}
									>
										{p.year}
									</span>
									{p.tags.slice(0, 2).map((t) => (
										<span class="text-[11px] font-medium text-white/45">{t}</span>
									))}
								</div>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.featured-work__header-row {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem 2rem;
	}

	.featured-work__count {
		flex-shrink: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-align: right;
		line-height: 1.4;
	}

	@media (max-width: 639px) {
		.featured-work__count {
			text-align: left;
		}
	}

	.featured-work__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(1.25rem, 3vw, 2rem);
	}

	@media (min-width: 768px) {
		.featured-work__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.featured-work__card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		text-decoration: none;
		color: inherit;
		border-radius: var(--radius-card);
		outline-offset: 4px;
	}

	.featured-work__card:focus-visible {
		outline: 2px solid var(--color-brand-green);
	}

	.featured-work__media {
		position: relative;
		overflow: hidden;
		border-radius: calc(var(--radius-card) - 0.15rem);
		border: 1px solid var(--color-surface-border);
		background: var(--color-surface-2);
		aspect-ratio: 16 / 10;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.06),
			0 24px 64px -32px rgb(0 0 0 / 0.65);
		transition:
			border-color 0.45s var(--ease-spring),
			box-shadow 0.55s var(--ease-spring),
			transform 0.55s var(--ease-spring);
	}

	.featured-work__card:hover .featured-work__media,
	.featured-work__card:focus-visible .featured-work__media {
		border-color: rgb(255 255 255 / 0.14);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.08),
			var(--shadow-glow-green),
			0 32px 80px -36px rgb(0 0 0 / 0.75);
		transform: translateY(-3px);
	}

	.featured-work__img {
		transition: transform 0.7s var(--ease-spring);
	}

	.featured-work__card:hover .featured-work__img,
	.featured-work__card:focus-visible .featured-work__img {
		transform: scale(1.03);
	}

	.featured-work__media:has(.portfolio-preview-pan) {
		aspect-ratio: auto;
		max-height: clamp(14rem, 42vw, 22rem);
	}

	.featured-work__media:has(.portfolio-preview-pan) .featured-work__img {
		display: block;
		width: 100%;
		height: auto;
		transform: none;
	}

	.featured-work__visit {
		position: absolute;
		right: 0.85rem;
		top: 0.85rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 9999px;
		border: 1px solid rgb(255 255 255 / 0.12);
		background: rgb(10 11 12 / 0.72);
		color: white;
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 0.35s ease,
			transform 0.35s var(--ease-spring),
			background 0.25s ease,
			color 0.25s ease;
		backdrop-filter: blur(8px);
	}

	.featured-work__card:hover .featured-work__visit,
	.featured-work__card:focus-visible .featured-work__visit {
		opacity: 1;
		transform: translateY(0);
	}

	.featured-work__card:hover .featured-work__visit {
		background: var(--color-brand-green);
		color: var(--color-brand-dark);
		border-color: transparent;
	}

	.featured-work__body {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding-inline: 0.15rem;
	}

	.featured-work__title {
		font-size: clamp(1.125rem, 2.2vw, 1.375rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: white;
		transition: color 0.3s ease;
	}

	.featured-work__card:hover .featured-work__title,
	.featured-work__card:focus-visible .featured-work__title {
		color: var(--color-brand-green);
	}

	.featured-work__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.featured-work__media,
		.featured-work__img,
		.featured-work__visit {
			transition: none;
		}

		.featured-work__card:hover .featured-work__media,
		.featured-work__card:focus-visible .featured-work__media {
			transform: none;
		}

		.featured-work__card:hover .featured-work__img,
		.featured-work__card:focus-visible .featured-work__img {
			transform: none;
		}

		.featured-work__visit {
			opacity: 1;
			transform: none;
		}
	}
</style>
