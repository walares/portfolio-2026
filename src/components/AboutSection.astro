---
import { ArrowRight, UserRound } from "@lucide/astro";
import { site } from "../data/site";
import { formatWhatsappPrefill, getLocaleContent, type Locale } from "../i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const content = getLocaleContent(locale);
const whatsappPrefill = encodeURIComponent(formatWhatsappPrefill(content, site));
const whatsappHref = `https://wa.me/${site.phoneE164}?text=${whatsappPrefill}`;
const initials = site.personName
	.split(" ")
	.map((part) => part[0])
	.join("")
	.slice(0, 2)
	.toUpperCase();
const hasPhoto = Boolean(site.aboutPhotoPath);
---

<section
	id="sobre-mi"
	class="relative scroll-mt-24 overflow-hidden px-4 py-20 sm:px-6 sm:py-28 lg:px-8"
	aria-labelledby="about-heading"
>
	<div
		class="graphic-orb graphic-orb--green -left-16 top-1/3 size-[min(20rem,45vw)] opacity-25"
		data-parallax="0.05"
		aria-hidden="true"
	/>
	<div class="mx-auto max-w-6xl">
		<div class="reveal grid items-center gap-10 lg:grid-cols-[minmax(0,17rem)_1fr] lg:gap-14">
			<div class="mx-auto lg:mx-0">
				{
					hasPhoto ? (
						<img
							src={site.aboutPhotoPath}
							alt={content.aboutSection.photoAlt}
							width={272}
							height={272}
							class="size-44 rounded-[1.75rem] border border-white/10 object-cover shadow-[0_24px_80px_-32px_rgb(0_0_0/0.85)] sm:size-52 lg:size-60"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<div
							class="flex size-44 flex-col items-center justify-center rounded-[1.75rem] border border-brand-green/25 bg-gradient-to-br from-brand-green/20 via-surface-2 to-brand-gold/10 shadow-[0_24px_80px_-32px_rgb(0_0_0/0.85)] sm:size-52 lg:size-60"
							role="img"
							aria-label={content.aboutSection.photoAlt}
						>
							<span class="font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">
								{initials}
							</span>
							<UserRound size={22} class="mt-3 text-brand-green/80" aria-hidden="true" />
						</div>
					)
				}
			</div>

			<div>
				<p class="eyebrow-pill mb-5">
					{content.aboutSection.eyebrow}
				</p>
				<h2
					id="about-heading"
					class="headline-section text-pretty text-3xl text-white sm:text-4xl lg:text-[2.75rem]"
				>
					{content.aboutSection.heading}
					<span class="mt-1 block text-brand-green">{content.aboutSection.headingAccent}</span>
				</h2>
				<p class="text-muted-body mt-5 max-w-2xl text-base leading-relaxed sm:text-lg">
					{content.aboutSection.bio}
				</p>

				<dl class="reveal-stagger mt-8 grid grid-cols-3 gap-3 sm:gap-4">
					{
						content.aboutSection.stats.map(({ value, label }) => (
							<div class="card-pomelo px-4 py-4 text-center sm:px-5 sm:py-5">
								<dt class="font-display text-2xl font-semibold tracking-tight text-brand-green sm:text-3xl">
									{value}
								</dt>
								<dd class="text-muted-caption mt-1 text-[11px] leading-snug sm:text-xs">{label}</dd>
							</div>
						))
					}
				</dl>

				<a
					href={whatsappHref}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-primary group mt-8 inline-flex items-center gap-2 rounded-full bg-brand-green px-7 py-3.5 text-sm font-semibold text-brand-dark"
				>
					{content.aboutSection.cta}
					<ArrowRight size={18} stroke-width={2.25} class="lucide-anim-hover-pop shrink-0" aria-hidden="true" />
				</a>
			</div>
		</div>
	</div>
</section>
