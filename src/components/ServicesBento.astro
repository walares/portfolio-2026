---
import {
	Briefcase,
	ListOrdered,
	Handshake,
	LayoutTemplate,
	Code,
	RefreshCw,
	Store,
	Globe2,
	ShoppingBag,
	Building2,
} from "@lucide/astro";

type StepAccent = "green" | "gold";

const useCases = [
	{
		title: "Landing de conversión",
		body: "Mensaje claro, CTA visible y formulario sin fricción.",
		icon: Store,
		accent: "green" as const,
	},
	{
		title: "Web corporativa",
		body: "Presencia profesional con servicios, equipo y contacto directo.",
		icon: Building2,
		accent: "gold" as const,
	},
	{
		title: "Tiendas online / e-commerce",
		body: "Catálogo, pagos o WhatsApp, con un panel que puedes gestionar.",
		icon: ShoppingBag,
		accent: "green" as const,
	},
	{
		title: "Producto digital",
		body: "Herramientas a medida: cotizadores, dashboards o flujos B2B.",
		icon: Globe2,
		accent: "gold" as const,
	},
];

const steps: {
	n: string;
	title: string;
	tag: string;
	body: string;
	icon: typeof Handshake;
	accent: StepAccent;
}[] = [
	{
		n: "01",
		title: "Reunión inicial",
		tag: "Brief",
		body: "Objetivos, referencias, cronograma y límites del proyecto antes de iniciar el desarrollo.",
		icon: Handshake,
		accent: "green",
	},
	{
		n: "02",
		title: "Arquitectura web",
		tag: "Estructura",
		body: "Mapa del sitio y orden de la información: el «plano» del proyecto.",
		icon: LayoutTemplate,
		accent: "gold",
	},
	{
		n: "03",
		title: "Desarrollo",
		tag: "Construcción",
		body: "Diseño, funciones e integraciones.",
		icon: Code,
		accent: "green",
	},
	{
		n: "04",
		title: "Pruebas y lanzamiento",
		tag: "Revisión",
		body: "Pruebas y ajustes hasta que la web refleje lo acordado.",
		icon: RefreshCw,
		accent: "gold",
	},
];

const accentIcon: Record<"green" | "gold", string> = {
	green: "border-brand-green/25 bg-brand-green/[0.1] text-brand-green",
	gold: "border-brand-gold/25 bg-brand-gold/[0.1] text-brand-gold",
};
---

<section
	id="servicios"
	class="relative scroll-mt-24 overflow-hidden px-4 py-20 sm:px-6 sm:py-28 lg:px-8"
	aria-labelledby="servicios-heading"
>
	<div
		class="graphic-orb graphic-orb--gold right-0 top-0 size-[min(24rem,50vw)] opacity-30"
		data-parallax="0.06"
		aria-hidden="true"
	/>
	<div class="mx-auto max-w-6xl">
		<header class="max-w-3xl reveal">
			<p class="eyebrow-pill mb-5" id="servicios-eyebrow">
				<Briefcase size={14} stroke-width={2} class="text-brand-gold" aria-hidden="true" />
				Servicios
			</p>
			<h2
				id="servicios-heading"
				class="headline-section text-pretty text-3xl text-white sm:text-4xl lg:text-[2.85rem]"
			>
				Distintas soluciones,
				<span class="headline-muted"> distintos</span>
				<span class="mt-1 block text-brand-green">objetivos.</span>
			</h2>
			<p class="text-muted-body mt-5 max-w-2xl text-base sm:text-lg">
				Soluciones distintas para cada necesidad: desde una landing hasta un producto digital completo.
			</p>
		</header>

		<!-- Carrusel horizontal estilo use cases -->
		<div class="reveal mt-12 lg:mt-14">
			<div class="hscroll-track -mx-4 px-4 sm:-mx-6 sm:px-6" data-hscroll aria-label="Tipos de proyecto">
				{
					useCases.map(({ title, body, icon: Icon, accent }) => (
						<article class="card-pomelo flex min-h-[220px] flex-col p-6">
							<div
								class:list={[
									"mb-4 inline-flex rounded-xl border p-3",
									accentIcon[accent],
								]}
							>
								<Icon size={22} stroke-width={1.85} aria-hidden="true" />
							</div>
							<h3 class="font-display text-xl font-medium tracking-tight text-white">{title}</h3>
							<p class="text-muted-body mt-2 flex-1 text-sm leading-relaxed">{body}</p>
							<span class="mt-4 text-xs font-semibold uppercase tracking-widest text-brand-green/80">
								Explorar →
							</span>
						</article>
					))
				}
			</div>
			<p class="text-eyebrow-brand mt-4 text-center text-xs sm:text-left">
				Desliza para ver más
			</p>
		</div>

		<div class="section-divider reveal my-16 sm:my-20" aria-hidden="true" />

		<div class="reveal">
			<p class="eyebrow-pill mb-4">
				<ListOrdered size={14} stroke-width={2} class="text-brand-green" aria-hidden="true" />
				Cómo trabajamos
			</p>
			<h3 class="headline-section text-2xl text-white sm:text-3xl">
				Del brief
				<span class="headline-muted"> al lanzamiento</span>
			</h3>
		</div>

		<ol class="reveal-stagger mt-10 grid gap-4 lg:grid-cols-2 lg:gap-5" aria-label="Etapas del proyecto">
			{
				steps.map(({ n, title, tag, body, icon: Icon, accent }) => (
					<li class="card-pomelo flex flex-col gap-4 p-6 sm:p-7 lg:flex-row lg:items-start lg:gap-6">
						<div class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-3">
							<span class="font-display text-3xl font-medium tabular-nums tracking-tight text-brand-green/90">
								{n}
							</span>
							<div class:list={["inline-flex rounded-xl border p-2.5", accentIcon[accent]]}>
								<Icon size={20} stroke-width={1.75} aria-hidden="true" />
							</div>
						</div>
						<div class="min-w-0 flex-1">
							<div class="flex flex-wrap items-center gap-2">
								<h4 class="font-display text-lg font-medium text-white">{title}</h4>
								<span
									class:list={[
										"rounded-md px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide",
										accent === "green"
											? "bg-brand-green/12 text-brand-green"
											: "bg-brand-gold/12 text-brand-gold",
									]}
								>
									{tag}
								</span>
							</div>
							<p class="text-muted-body mt-2 text-sm leading-relaxed">{body}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
